{
  "rules": {
    ".read": false,
    ".write": false,
    "echo": {
      "presence": {
        ".read": true,
        "$presenceId": {
          ".write": "$presenceId.length <= 64",
          ".validate": "newData.hasChildren(['role', 'joinedAt'])",
          "role": { ".validate": "newData.isString() && newData.val().matches(/^(speaker|sender|landing)$/)" },
          "joinedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        }
      },
      "events": {
        ".read": true,
        ".indexOn": ["at"],
        "$eventId": {
          ".write": true,
          ".validate": "newData.hasChildren(['event', 'from', 'payload', 'at'])",
          "event": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
          "from": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "payload": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
